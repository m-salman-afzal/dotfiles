[Desktop Entry]
Comment=Handy
Exec="/home/satop/Applications/Handy"
StartupWMClass=handy
Icon=handy
Name=Handy
Type=Application
X-AppImage-Version=0.10.0
Actions=Uninstall;

[Desktop Action Uninstall]
Name=Move to Trash
Exec=/home/satop/Applications/AppManager uninstall "/home/satop/Applications/Handy"
Icon=user-trash
