# defaults
shell-integration-features = no-cursor

# keybindings
# performable: no selection -> falls through as SIGINT
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# appearence
theme=Dracula
split-divider-color = #89b4fa

# titlebar: merge tabs into it, no shadow, terminal bg color -> vscode-ish unified bar
gtk-titlebar-style = tabs
gtk-toolbar-style = flat
window-theme = ghostty

# unfocused
unfocused-split-opacity = 0.65
unfocused-split-fill = #1e1e2e

# cursor
cursor-style= block
cursor-color = #89b4fa

# session
window-save-state = always
